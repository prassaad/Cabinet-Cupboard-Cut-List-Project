# WallView API — environment configuration
# Copy to .env and fill in. NEVER commit .env.

# App
APP_ENV=dev                     # dev | prod  (dev = verbose errors)
APP_URL=http://localhost/wallview-api/public

# Database (local XAMPP MySQL/MariaDB) — dev must NOT point at production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wallview_dev
DB_USER=root
DB_PASS=

# JWT — REQUIRED. The app refuses to boot if JWT_KEY is empty/missing.
# Generate a long random secret, e.g.:  php -r "echo bin2hex(random_bytes(48));"
JWT_KEY=
JWT_ISSUER=wallview-api
JWT_AUDIENCE=wallview-api
JWT_EXPIRY_MINUTES=60
REFRESH_EXPIRY_DAYS=7

# Engine service (Node) — runs the real engine headless; PHP proxies to it.
ENGINE_URL=http://127.0.0.1:4001
ENGINE_KEY=
ENGINE_TIMEOUT_MS=5000
